{
  "name": "catatan-pengeluaran",
  "version": "1.0.0",
  "private": true,
  "description": "Website pencatatan pengeluaran pribadi (Personal Expense Tracker)",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "build:server": "npm run build -w server",
    "start:server": "npm run start -w server",
    "typecheck": "npm run typecheck -w client"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
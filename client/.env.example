# =====================================================
# Konfigurasi frontend. Salin menjadi .env lalu isi bila
# ingin memakai sinkronisasi online (Supabase via backend).
# =====================================================

# URL backend API. Kosongkan untuk memakai mode lokal (localStorage).
# Saat development, biarkan kosong dan pakai proxy Vite (atau isi
# http://localhost:3001). Saat deployment, isi dengan URL backend
# yang sudah di-deploy, contoh https://api.contoh.com
VITE_API_URL=
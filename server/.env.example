# =====================================================
# Konfigurasi backend. Salin file ini menjadi .env lalu isi.
# JANGAN pernah commit file .env ke git.
# =====================================================

# Port yang dipakai backend
PORT=3001

# --- Supabase (wajib untuk sinkronisasi antar perangkat) ---
# URL project Supabase. Contoh: https://abcdefgh.supabase.co
SUPABASE_URL=

# SERVICE ROLE key (bukan anon key). Key ini berkuasa penuh,
# jadi HANYA boleh disimpan di backend, tidak pernah di frontend.
SUPABASE_SERVICE_ROLE_KEY=

# --- Kunci akses bersama (shared access key) ---
# Karena website tidak memakai login, semua request ke API harus
# menyertakan kunci ini. Masukkan kunci yang sama di halaman
# Pengaturan pada aplikasi web (disimpan di perangkat kamu).
# Gunakan string acak yang panjang, misalnya hasil dari:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ACCESS_KEY=